'use client';

import { useState, useRef, useEffect, useCallback } from 'react';

// ═══════════════════════════════════════════════════════════════════
// TAPE LAB — BPM & Delay Time Calculator
// A-Level Music Technology · 2.5 Numeracy · 1.12 Delay
//
// Aesthetic: stylised tribute to vintage tape-delay hardware
// (Echoplex EP-3, Roland Space Echo) reimagined with contemporary
// editorial precision. Refined, not retro-skeuomorphic.
//
// Real Web Audio: synthesised percussion + genuine DelayNode with
// feedback loop, low-pass on wet signal, and live tempo-locked grid.
// ═══════════════════════════════════════════════════════════════════

const FONT_LINK_HREF = 'https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,800&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700;800&display=swap';

const TAPE_LAB_CSS = `
.tape-lab {
  --paper:        #F1E8D0;
  --paper-edge:   #E0D5B7;
  --paper-deep:   #DCD0AB;
  --ink:          #1A1612;
  --ink-soft:     #4B4239;
  --ink-faded:    #7A6B5A;
  --oxblood:      #7A1F2B;
  --oxblood-deep: #5C1620;
  --tape:         #2F1F12;
  --tape-edge:    #1A0F08;
  --steel:        #C9C2B5;
  --steel-light:  #E5DFD2;
  --amber:        #FFB347;
  --amber-glow:   rgba(255, 179, 71, 0.45);
  --phosphor:     #7FBF3F;
  --phosphor-glow:rgba(127, 191, 63, 0.5);
  --crimson:      #C53030;

  --f-display:  'Fraunces', 'Times New Roman', serif;
  --f-body:     'IBM Plex Sans', system-ui, sans-serif;
  --f-mono:     'JetBrains Mono', ui-monospace, monospace;

  font-family: var(--f-body);
  color: var(--ink);
  background: var(--paper);
  background-image:
    repeating-linear-gradient(0deg, transparent 0, transparent 23px, rgba(122, 31, 43, 0.025) 23px, rgba(122, 31, 43, 0.025) 24px),
    radial-gradient(ellipse at top, rgba(255,255,255,0.4) 0%, transparent 60%);
  min-height: 100vh;
}

.tape-lab * { box-sizing: border-box; }

/* ═══ TYPE ═══ */
.tape-display { font-family: var(--f-display); font-weight: 800; letter-spacing: -0.025em; line-height: 0.95; }
.tape-mono { font-family: var(--f-mono); font-feature-settings: 'tnum'; }
.tape-stencil {
  font-family: var(--f-mono); font-weight: 700; letter-spacing: 0.18em;
  text-transform: uppercase; font-size: 10px;
}

/* ═══ HEADER ═══ */
.tl-header {
  padding: 28px 40px 24px;
  border-bottom: 2px solid var(--ink);
  display: flex; align-items: flex-end; justify-content: space-between;
  flex-wrap: wrap; gap: 24px;
}
.tl-title {
  font-family: var(--f-display); font-weight: 800;
  font-size: clamp(36px, 5.5vw, 64px); margin: 0;
  letter-spacing: -0.035em; line-height: 0.92;
}
.tl-title .amp {
  font-style: italic; font-weight: 400;
  color: var(--oxblood);
  font-feature-settings: 'ss01', 'liga';
}
.tl-stamp {
  display: inline-block; padding: 4px 10px;
  border: 1.5px solid var(--oxblood); color: var(--oxblood);
  font-family: var(--f-mono); font-weight: 700; font-size: 10px;
  letter-spacing: 0.2em; text-transform: uppercase;
  transform: rotate(-2deg); margin-left: 4px;
}
.tl-eyebrow {
  font-family: var(--f-mono); font-weight: 600; font-size: 11px;
  letter-spacing: 0.25em; text-transform: uppercase; color: var(--oxblood);
  margin-bottom: 8px;
}

/* ═══ TOP BAR — TOPIC TAGS ═══ */
.tl-tag-row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
.tl-tag {
  font-family: var(--f-mono); font-weight: 600; font-size: 10px;
  letter-spacing: 0.18em; text-transform: uppercase;
  padding: 5px 10px; border: 1.5px solid var(--ink);
  background: var(--paper);
  color: var(--ink);
}
.tl-tag.crimson { border-color: var(--oxblood); color: var(--oxblood); }
.tl-tag.live    { border-color: var(--phosphor); color: var(--phosphor); background: var(--ink); }

/* ═══ LAYOUT GRID ═══ */
.tl-main {
  max-width: 1280px; margin: 0 auto;
  padding: 32px 40px 48px;
  display: grid; grid-template-columns: 260px 1fr;
  gap: 32px;
}
@media (max-width: 880px) {
  .tl-main { grid-template-columns: 1fr; padding: 24px 20px 40px; }
}

/* ═══ LEFT RAIL ═══ */
.tl-rail {
  display: flex; flex-direction: column; gap: 24px;
}
.tl-rail-section {
  border: 1.5px solid var(--ink);
  background: var(--paper);
  padding: 18px;
}
.tl-rail-label {
  font-family: var(--f-mono); font-weight: 700; font-size: 10px;
  letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--ink-faded); margin-bottom: 12px;
  display: flex; justify-content: space-between; align-items: center;
}

/* ═══ SOURCE PADS ═══ */
.tl-pads { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
.tl-pad {
  aspect-ratio: 1; border: 1.5px solid var(--ink);
  background: linear-gradient(155deg, var(--paper) 0%, var(--paper-deep) 100%);
  cursor: pointer; user-select: none;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  font-family: var(--f-mono); font-weight: 700; font-size: 10px;
  letter-spacing: 0.15em; color: var(--ink);
  transition: transform 80ms ease-out, background 100ms ease-out, box-shadow 100ms ease-out;
  position: relative; overflow: hidden;
}
.tl-pad::before {
  content: ''; position: absolute; inset: 4px;
  border: 1px solid rgba(122, 31, 43, 0.15);
  pointer-events: none;
}
.tl-pad:hover { background: linear-gradient(155deg, var(--paper-deep), var(--paper-edge)); }
.tl-pad.hot {
  background: var(--oxblood); color: var(--paper);
  box-shadow: 0 0 16px var(--amber-glow), inset 0 0 14px rgba(255,179,71,0.3);
  transform: translateY(1px);
}
.tl-pad-key {
  font-family: var(--f-mono); font-weight: 800; font-size: 22px;
  letter-spacing: -0.02em; line-height: 1; margin-bottom: 4px;
}
.tl-pad-name { font-size: 9px; letter-spacing: 0.18em; }

/* ═══ MODE TOGGLE ═══ */
.tl-modes { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
.tl-mode {
  border: 1.5px solid var(--ink); background: var(--paper);
  padding: 12px 8px; cursor: pointer; user-select: none;
  font-family: var(--f-mono); font-weight: 700; font-size: 10px;
  letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink);
  transition: background 120ms ease-out, color 120ms ease-out;
}
.tl-mode:first-child { border-right: none; }
.tl-mode.active {
  background: var(--ink); color: var(--paper);
}

/* ═══ ENGINE PANEL (centrepiece) ═══ */
.tl-engine {
  border: 2px solid var(--ink);
  background:
    radial-gradient(circle at 20% 0%, rgba(255,255,255,0.5), transparent 50%),
    linear-gradient(180deg, var(--paper) 0%, var(--paper-deep) 100%);
  padding: 28px 32px 24px;
  position: relative;
  box-shadow: 0 4px 0 var(--ink), 6px 8px 0 rgba(26, 22, 18, 0.08);
}
.tl-engine::before {
  content: ''; position: absolute; top: 8px; right: 12px; bottom: 8px; left: 12px;
  border: 1px solid rgba(26, 22, 18, 0.18); pointer-events: none;
}
.tl-engine-header {
  display: flex; justify-content: space-between; align-items: center;
  padding-bottom: 16px; margin-bottom: 20px;
  border-bottom: 1px dashed rgba(26, 22, 18, 0.3);
}

/* ═══ MASSIVE READOUT (the instrument display) ═══ */
.tl-readout {
  background: linear-gradient(180deg, var(--tape-edge) 0%, var(--tape) 100%);
  border: 2px solid var(--ink);
  padding: 24px 28px;
  position: relative;
  box-shadow: inset 0 4px 16px rgba(0,0,0,0.6), inset 0 0 0 1px rgba(255,179,71,0.05);
  margin-bottom: 24px;
  border-radius: 2px;
}
.tl-readout::before {
  content: ''; position: absolute; inset: 0;
  background: repeating-linear-gradient(0deg, transparent 0, transparent 2px, rgba(255,179,71,0.04) 2px, rgba(255,179,71,0.04) 3px);
  pointer-events: none;
}
.tl-readout-formula {
  font-family: var(--f-mono); font-size: 13px; font-weight: 500;
  color: rgba(255, 179, 71, 0.55); letter-spacing: 0.05em;
  margin-bottom: 6px; text-align: center;
  text-shadow: 0 0 6px var(--amber-glow);
}
.tl-readout-formula em {
  color: var(--amber); font-style: normal; font-weight: 700;
  text-shadow: 0 0 12px var(--amber-glow);
}
.tl-readout-value {
  font-family: var(--f-mono); font-weight: 800;
  font-size: clamp(72px, 14vw, 144px); line-height: 0.85;
  letter-spacing: -0.06em;
  color: var(--amber);
  text-align: center;
  text-shadow: 0 0 20px var(--amber-glow), 0 0 4px rgba(255, 179, 71, 0.6);
  font-feature-settings: 'tnum';
  margin: 4px 0;
}
.tl-readout-unit {
  font-family: var(--f-mono); font-size: 22px; font-weight: 600;
  color: rgba(255,179,71,0.7); letter-spacing: 0.2em;
  text-shadow: 0 0 8px var(--amber-glow);
  margin-left: 8px; vertical-align: 0.55em;
}
.tl-readout-meta {
  display: flex; justify-content: space-between; align-items: center;
  font-family: var(--f-mono); font-size: 10px; color: rgba(255,179,71,0.55);
  letter-spacing: 0.2em; text-transform: uppercase; padding-top: 4px;
}

/* ═══ KNOB ROW ═══ */
.tl-knobs {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
  gap: 16px;
  padding: 20px 0;
  border-top: 1px dashed rgba(26, 22, 18, 0.3);
}
.tl-knob-cell { text-align: center; }
.tl-knob-label {
  font-family: var(--f-mono); font-weight: 700; font-size: 9px;
  letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--ink-faded); margin-top: 8px;
}
.tl-knob-value {
  font-family: var(--f-mono); font-weight: 700; font-size: 12px;
  color: var(--ink); margin-top: 2px;
}

/* ═══ TRANSPORT ═══ */
.tl-transport {
  display: flex; gap: 12px; align-items: center; flex-wrap: wrap;
  padding-top: 20px; border-top: 1px dashed rgba(26, 22, 18, 0.3);
}
.tl-button {
  font-family: var(--f-mono); font-weight: 700; font-size: 11px;
  letter-spacing: 0.18em; text-transform: uppercase;
  padding: 12px 18px; cursor: pointer;
  border: 1.5px solid var(--ink); background: var(--paper); color: var(--ink);
  transition: all 100ms ease-out;
  user-select: none;
}
.tl-button:hover { background: var(--paper-edge); }
.tl-button:active { transform: translateY(1px); }
.tl-button.primary { background: var(--ink); color: var(--paper); }
.tl-button.primary:hover { background: var(--oxblood); border-color: var(--oxblood); }
.tl-button.crimson { background: var(--oxblood); color: var(--paper); border-color: var(--oxblood); }
.tl-button.crimson:hover { background: var(--oxblood-deep); }
.tl-button.ghost { background: transparent; }
.tl-button.tap { min-width: 90px; }

/* LEDs */
.tl-leds { display: flex; gap: 7px; align-items: center; margin-left: auto; }
.tl-led {
  width: 12px; height: 12px; border-radius: 50%;
  background: rgba(26, 22, 18, 0.5);
  border: 1.5px solid var(--ink);
  transition: background 80ms ease-out, box-shadow 80ms ease-out;
}
.tl-led.on.beat   { background: var(--amber); box-shadow: 0 0 12px var(--amber-glow), inset 0 0 4px rgba(255,255,255,0.4); }
.tl-led.on.lock   { background: var(--phosphor); box-shadow: 0 0 14px var(--phosphor-glow), inset 0 0 4px rgba(255,255,255,0.4); }

/* ═══ TAPE GRID (the rolling visualisation) ═══ */
.tl-tape {
  margin-top: 28px;
  border: 2px solid var(--ink);
  background: var(--tape);
  position: relative;
  box-shadow: inset 0 4px 12px rgba(0,0,0,0.5);
}
.tl-tape canvas { display: block; width: 100%; }

/* ═══ BPM SLIDER ═══ */
.tl-bpm-row { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
.tl-bpm-display {
  font-family: var(--f-display); font-weight: 800;
  font-size: 56px; line-height: 0.9; letter-spacing: -0.04em;
  color: var(--ink);
}
.tl-bpm-display .small { font-size: 14px; color: var(--ink-faded); margin-left: 6px; vertical-align: 1.5em; letter-spacing: 0.2em; font-family: var(--f-mono); font-weight: 600; text-transform: uppercase; }
.tl-bpm-slider {
  flex: 1; min-width: 180px; appearance: none;
  height: 6px; background: var(--ink); border-radius: 0;
  outline: none; cursor: pointer;
}
.tl-bpm-slider::-webkit-slider-thumb {
  appearance: none; width: 22px; height: 22px;
  background: var(--oxblood); border: 2px solid var(--ink);
  cursor: ew-resize; border-radius: 1px;
  box-shadow: 0 2px 0 var(--ink);
}
.tl-bpm-slider::-moz-range-thumb {
  width: 22px; height: 22px; background: var(--oxblood); border: 2px solid var(--ink);
  cursor: ew-resize; border-radius: 1px;
}
.tl-bpm-presets { display: flex; gap: 6px; flex-wrap: wrap; }
.tl-bpm-preset {
  font-family: var(--f-mono); font-size: 11px; font-weight: 600;
  padding: 4px 9px; border: 1px solid var(--ink); background: var(--paper);
  cursor: pointer;
}
.tl-bpm-preset.active { background: var(--ink); color: var(--paper); }

/* ═══ CHALLENGE PANEL ═══ */
.tl-challenge {
  margin-top: 24px; padding: 20px 24px;
  border: 2px solid var(--oxblood); background: rgba(122, 31, 43, 0.05);
  position: relative;
}
.tl-challenge::before {
  content: 'SYNC CHALLENGE';
  position: absolute; top: -10px; left: 16px;
  background: var(--paper); padding: 0 8px;
  font-family: var(--f-mono); font-weight: 700; font-size: 10px;
  letter-spacing: 0.2em; color: var(--oxblood);
}
.tl-challenge-q {
  font-family: var(--f-display); font-weight: 600;
  font-size: 22px; line-height: 1.3; margin: 4px 0 16px;
  letter-spacing: -0.015em;
}
.tl-challenge-q strong { color: var(--oxblood); font-weight: 800; font-style: italic; }
.tl-challenge-row {
  display: flex; gap: 12px; align-items: center; flex-wrap: wrap;
}
.tl-input {
  font-family: var(--f-mono); font-weight: 700; font-size: 22px;
  padding: 10px 14px; width: 140px; text-align: center;
  border: 2px solid var(--ink); background: var(--paper); color: var(--ink);
}
.tl-input:focus { outline: none; border-color: var(--oxblood); box-shadow: 0 0 0 3px rgba(122,31,43,0.15); }
.tl-feedback {
  margin-top: 14px; padding: 14px 16px;
  border-left: 4px solid;
  font-family: var(--f-body); font-size: 14px; line-height: 1.55;
}
.tl-feedback.correct { border-color: var(--phosphor); background: rgba(127, 191, 63, 0.08); color: var(--ink); }
.tl-feedback.wrong   { border-color: var(--crimson);  background: rgba(197, 48, 48, 0.06); color: var(--ink); }
.tl-feedback strong { font-family: var(--f-mono); }

/* ═══ DRAWER ═══ */
.tl-drawer-handle {
  position: fixed; right: 0; top: 50%; transform: translateY(-50%);
  display: flex; flex-direction: column; gap: 6px;
  z-index: 50;
}
.tl-drawer-handle button {
  writing-mode: vertical-rl; transform: rotate(180deg);
  padding: 14px 8px; cursor: pointer;
  font-family: var(--f-mono); font-weight: 700; font-size: 10px;
  letter-spacing: 0.22em; text-transform: uppercase;
  background: var(--ink); color: var(--paper); border: none;
  border-left: 2px solid var(--oxblood);
}
.tl-drawer-handle button:hover { background: var(--oxblood); border-left-color: var(--ink); }

.tl-drawer-overlay {
  position: fixed; inset: 0; background: rgba(26,22,18,0.4);
  z-index: 60; backdrop-filter: blur(2px);
  animation: tl-fade 200ms ease-out;
}
.tl-drawer {
  position: fixed; top: 0; right: 0; bottom: 0;
  width: min(560px, 92vw); background: var(--paper);
  border-left: 3px solid var(--ink); z-index: 61;
  overflow-y: auto; padding: 32px 36px;
  box-shadow: -12px 0 32px rgba(0,0,0,0.18);
  animation: tl-slide-in 280ms cubic-bezier(0.2, 0.7, 0.2, 1.0);
}
@keyframes tl-slide-in { from { transform: translateX(100%); } to { transform: translateX(0); } }
@keyframes tl-fade { from { opacity: 0; } to { opacity: 1; } }
.tl-drawer-close {
  position: absolute; top: 16px; right: 16px;
  width: 32px; height: 32px; border: 1.5px solid var(--ink);
  background: var(--paper); cursor: pointer;
  font-family: var(--f-mono); font-size: 16px; line-height: 1;
}
.tl-drawer h2 {
  font-family: var(--f-display); font-weight: 800;
  font-size: 36px; letter-spacing: -0.025em; margin: 0 0 24px;
}
.tl-drawer h3 {
  font-family: var(--f-display); font-weight: 600; font-style: italic;
  font-size: 22px; margin: 28px 0 10px; color: var(--oxblood);
}
.tl-drawer p, .tl-drawer li {
  font-family: var(--f-body); font-size: 15px; line-height: 1.65; color: var(--ink-soft);
}
.tl-drawer .formula-block {
  font-family: var(--f-mono); font-weight: 600; font-size: 18px;
  background: var(--ink); color: var(--amber);
  padding: 16px 20px; margin: 16px 0;
  text-align: center; letter-spacing: 0.04em;
  text-shadow: 0 0 8px var(--amber-glow);
}

/* Reference table */
.tl-ref-table { width: 100%; border-collapse: collapse; margin-top: 8px; font-family: var(--f-mono); font-size: 12px; }
.tl-ref-table th, .tl-ref-table td { padding: 7px 5px; text-align: right; border-bottom: 1px solid var(--paper-edge); }
.tl-ref-table th { font-size: 10px; letter-spacing: 0.15em; color: var(--ink-faded); text-transform: uppercase; font-weight: 700; }
.tl-ref-table td:first-child, .tl-ref-table th:first-child { text-align: left; font-weight: 600; color: var(--ink); }
.tl-ref-table tr:hover td { background: var(--paper-deep); cursor: pointer; }

/* ═══ Note value picker ═══ */
.tl-notes {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
  gap: 6px; margin-top: 16px;
}
.tl-note-btn {
  border: 1.5px solid var(--ink); background: var(--paper);
  padding: 10px 6px; cursor: pointer; user-select: none;
  display: flex; flex-direction: column; align-items: center; gap: 2px;
  transition: all 100ms ease-out;
  font-family: var(--f-body);
}
.tl-note-btn:hover { background: var(--paper-edge); }
.tl-note-btn.active {
  background: var(--ink); color: var(--paper);
  box-shadow: inset 0 0 0 2px var(--paper), inset 0 0 0 3px var(--ink);
}
.tl-note-btn.compare {
  background: var(--oxblood); color: var(--paper); border-color: var(--oxblood);
}
.tl-note-symbol { font-family: var(--f-display); font-size: 20px; line-height: 1; }
.tl-note-label  { font-family: var(--f-mono); font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase; }
.tl-note-ms     { font-family: var(--f-mono); font-size: 11px; font-weight: 700; }

@keyframes tl-pulse {
  0% { transform: scale(1); }
  50% { transform: scale(0.92); }
  100% { transform: scale(1); }
}
.tl-pulsing { animation: tl-pulse 110ms ease-out; }
`;

// ════════════════════════════════════════════════════════════════════
// NOTE VALUES
// ════════════════════════════════════════════════════════════════════
const NOTE_VALUES = [
  { id: 'whole',         label: 'Whole',          symbol: '𝅝',   multiplier: 4,    spoken: 'whole note' },
  { id: 'half',          label: 'Half',           symbol: '𝅗𝅥',   multiplier: 2,    spoken: 'half note' },
  { id: 'dotted-quarter',label: 'Dot · 1/4',      symbol: '♩.',  multiplier: 1.5,  spoken: 'dotted quarter note' },
  { id: 'quarter',       label: 'Quarter',        symbol: '♩',   multiplier: 1,    spoken: 'quarter note' },
  { id: 'dotted-eighth', label: 'Dot · 1/8',      symbol: '♪.',  multiplier: 0.75, spoken: 'dotted eighth note' },
  { id: 'eighth',        label: 'Eighth',         symbol: '♪',   multiplier: 0.5,  spoken: 'eighth note' },
  { id: 'eighth-triplet',label: '1/8 Trip',       symbol: '♪³',  multiplier: 1/3,  spoken: 'eighth triplet' },
  { id: 'sixteenth',     label: 'Sixteenth',      symbol: '𝅘𝅥𝅯',   multiplier: 0.25, spoken: 'sixteenth note' },
];

const calcMs = (bpm, mult) => (60000 / bpm) * mult;

// ════════════════════════════════════════════════════════════════════
// SAMPLE SYNTHESIS
// Each function returns the source's gain node so we can route it
// through the delay engine.
// ════════════════════════════════════════════════════════════════════
const synths = {
  kick: (ctx, when, dest) => {
    const o = ctx.createOscillator(), g = ctx.createGain();
    o.type = 'sine';
    o.frequency.setValueAtTime(140, when);
    o.frequency.exponentialRampToValueAtTime(45, when + 0.18);
    g.gain.setValueAtTime(0.0001, when);
    g.gain.exponentialRampToValueAtTime(0.95, when + 0.005);
    g.gain.exponentialRampToValueAtTime(0.0001, when + 0.4);
    o.connect(g); g.connect(dest);
    o.start(when); o.stop(when + 0.45);
  },
  snare: (ctx, when, dest) => {
    const noise = makeNoise(ctx, 0.2);
    const bp = ctx.createBiquadFilter();
    bp.type = 'bandpass'; bp.frequency.value = 1900; bp.Q.value = 1.2;
    const ng = ctx.createGain();
    ng.gain.setValueAtTime(0.0001, when);
    ng.gain.exponentialRampToValueAtTime(0.6, when + 0.002);
    ng.gain.exponentialRampToValueAtTime(0.0001, when + 0.18);
    noise.connect(bp); bp.connect(ng); ng.connect(dest);
    noise.start(when);
    // Body tone
    const o = ctx.createOscillator(), og = ctx.createGain();
    o.type = 'triangle'; o.frequency.value = 200;
    og.gain.setValueAtTime(0.0001, when);
    og.gain.exponentialRampToValueAtTime(0.3, when + 0.002);
    og.gain.exponentialRampToValueAtTime(0.0001, when + 0.08);
    o.connect(og); og.connect(dest);
    o.start(when); o.stop(when + 0.1);
  },
  clap: (ctx, when, dest) => {
    [0, 0.011, 0.024, 0.04].forEach((dt, i) => {
      const noise = makeNoise(ctx, 0.06);
      const bp = ctx.createBiquadFilter();
      bp.type = 'bandpass'; bp.frequency.value = 1500; bp.Q.value = 1.5;
      const g = ctx.createGain();
      const peak = i === 3 ? 0.5 : 0.28;
      g.gain.setValueAtTime(0.0001, when + dt);
      g.gain.exponentialRampToValueAtTime(peak, when + dt + 0.001);
      g.gain.exponentialRampToValueAtTime(0.0001, when + dt + 0.06);
      noise.connect(bp); bp.connect(g); g.connect(dest);
      noise.start(when + dt);
    });
  },
  rim: (ctx, when, dest) => {
    const o = ctx.createOscillator(), g = ctx.createGain();
    o.type = 'square'; o.frequency.value = 1800;
    g.gain.setValueAtTime(0.0001, when);
    g.gain.exponentialRampToValueAtTime(0.45, when + 0.001);
    g.gain.exponentialRampToValueAtTime(0.0001, when + 0.05);
    o.connect(g); g.connect(dest);
    o.start(when); o.stop(when + 0.06);
    // Click overtone
    const o2 = ctx.createOscillator(), g2 = ctx.createGain();
    o2.type = 'triangle'; o2.frequency.value = 320;
    g2.gain.setValueAtTime(0.0001, when);
    g2.gain.exponentialRampToValueAtTime(0.3, when + 0.001);
    g2.gain.exponentialRampToValueAtTime(0.0001, when + 0.04);
    o2.connect(g2); g2.connect(dest);
    o2.start(when); o2.stop(when + 0.05);
  },
  vox: (ctx, when, dest) => {
    // Formant-ish "ah"
    const fundamental = 220;
    const harmonics = [
      { f: fundamental,     g: 0.3 },
      { f: fundamental * 2, g: 0.18 },
      { f: 750,             g: 0.22 }, // first formant
      { f: 1200,            g: 0.14 }, // second formant
      { f: 2500,            g: 0.06 },
    ];
    const env = ctx.createGain();
    env.gain.setValueAtTime(0.0001, when);
    env.gain.exponentialRampToValueAtTime(1, when + 0.04);
    env.gain.linearRampToValueAtTime(0.5, when + 0.2);
    env.gain.exponentialRampToValueAtTime(0.0001, when + 0.45);
    env.connect(dest);
    harmonics.forEach(h => {
      const o = ctx.createOscillator(), g = ctx.createGain();
      o.type = 'sine'; o.frequency.value = h.f;
      g.gain.value = h.g * 0.4;
      o.connect(g); g.connect(env);
      o.start(when); o.stop(when + 0.5);
    });
  },
  pluck: (ctx, when, dest) => {
    const o = ctx.createOscillator(), g = ctx.createGain();
    const lp = ctx.createBiquadFilter();
    lp.type = 'lowpass';
    o.type = 'sawtooth'; o.frequency.value = 330;
    lp.frequency.setValueAtTime(2400, when);
    lp.frequency.exponentialRampToValueAtTime(450, when + 0.3);
    g.gain.setValueAtTime(0.0001, when);
    g.gain.exponentialRampToValueAtTime(0.5, when + 0.003);
    g.gain.exponentialRampToValueAtTime(0.0001, when + 0.4);
    o.connect(lp); lp.connect(g); g.connect(dest);
    o.start(when); o.stop(when + 0.45);
  },
};

function makeNoise(ctx, durationSec) {
  const buf = ctx.createBuffer(1, ctx.sampleRate * durationSec, ctx.sampleRate);
  const d = buf.getChannelData(0);
  for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
  const src = ctx.createBufferSource(); src.buffer = buf;
  return src;
}

// ════════════════════════════════════════════════════════════════════
// SOURCE PADS
// ════════════════════════════════════════════════════════════════════
const SOURCES = [
  { id: 'kick',  label: 'KICK',   key: '1', synth: synths.kick },
  { id: 'snare', label: 'SNARE',  key: '2', synth: synths.snare },
  { id: 'clap',  label: 'CLAP',   key: '3', synth: synths.clap },
  { id: 'rim',   label: 'RIM',    key: '4', synth: synths.rim },
  { id: 'vox',   label: 'VOX',    key: '5', synth: synths.vox },
  { id: 'pluck', label: 'PLUCK',  key: '6', synth: synths.pluck },
];

// ════════════════════════════════════════════════════════════════════
// KNOB COMPONENT
// Vertical-drag rotation knob (industry standard for audio).
// ════════════════════════════════════════════════════════════════════
const Knob = ({ value, min, max, step = 0.01, onChange, format, ariaLabel }) => {
  const [dragging, setDragging] = useState(false);
  const startY = useRef(0);
  const startV = useRef(0);

  useEffect(() => {
    if (!dragging) return;
    const move = (e) => {
      const cy = e.touches ? e.touches[0].clientY : e.clientY;
      const dy = startY.current - cy;
      const range = max - min;
      // 220px = full sweep
      const delta = (dy / 220) * range;
      let next = startV.current + delta;
      next = Math.round(next / step) * step;
      next = Math.max(min, Math.min(max, next));
      onChange(next);
    };
    const up = () => setDragging(false);
    window.addEventListener('mousemove', move);
    window.addEventListener('mouseup', up);
    window.addEventListener('touchmove', move, { passive: false });
    window.addEventListener('touchend', up);
    return () => {
      window.removeEventListener('mousemove', move);
      window.removeEventListener('mouseup', up);
      window.removeEventListener('touchmove', move);
      window.removeEventListener('touchend', up);
    };
  }, [dragging, max, min, onChange, step]);

  const onDown = (e) => {
    e.preventDefault();
    const cy = e.touches ? e.touches[0].clientY : e.clientY;
    startY.current = cy;
    startV.current = value;
    setDragging(true);
  };

  const onWheel = (e) => {
    e.preventDefault();
    const range = max - min;
    const delta = -e.deltaY / 1000 * range;
    let next = value + delta;
    next = Math.round(next / step) * step;
    next = Math.max(min, Math.min(max, next));
    onChange(next);
  };

  const pct = (value - min) / (max - min);
  const angle = -135 + pct * 270;

  return (
    <div
      onMouseDown={onDown}
      onTouchStart={onDown}
      onWheel={onWheel}
      role="slider"
      tabIndex={0}
      aria-label={ariaLabel}
      aria-valuemin={min}
      aria-valuemax={max}
      aria-valuenow={value}
      style={{ cursor: dragging ? 'grabbing' : 'ns-resize', userSelect: 'none', display: 'inline-block' }}
    >
      <svg width="76" height="76" viewBox="0 0 100 100" style={{ display: 'block', margin: '0 auto' }}>
        <defs>
          <radialGradient id="knobFace" cx="50%" cy="35%" r="55%">
            <stop offset="0%" stopColor="#E5DFD2" />
            <stop offset="55%" stopColor="#C9C2B5" />
            <stop offset="100%" stopColor="#8B8478" />
          </radialGradient>
          <radialGradient id="knobInset" cx="50%" cy="50%" r="50%">
            <stop offset="80%" stopColor="rgba(26,22,18,0)" />
            <stop offset="100%" stopColor="rgba(26,22,18,0.25)" />
          </radialGradient>
        </defs>
        {/* Tick marks */}
        {[...Array(11)].map((_, i) => {
          const a = (-135 + (i / 10) * 270) * Math.PI / 180;
          const x1 = 50 + Math.cos(a - Math.PI/2) * 47;
          const y1 = 50 + Math.sin(a - Math.PI/2) * 47;
          const x2 = 50 + Math.cos(a - Math.PI/2) * 42;
          const y2 = 50 + Math.sin(a - Math.PI/2) * 42;
          return <line key={i} x1={x1} y1={y1} x2={x2} y2={y2} stroke="#1A1612" strokeWidth="1.2" />;
        })}
        {/* Outer chassis */}
        <circle cx="50" cy="50" r="38" fill="#1A1612" />
        {/* Brushed metal face */}
        <circle cx="50" cy="50" r="34" fill="url(#knobFace)" />
        <circle cx="50" cy="50" r="34" fill="url(#knobInset)" />
        {/* Stripes for brushed steel feel */}
        {[...Array(5)].map((_, i) => (
          <line key={i} x1={50 - 28} y1={50 - 16 + i * 8} x2={50 + 28} y2={50 - 16 + i * 8}
                stroke="rgba(26,22,18,0.07)" strokeWidth="0.8" />
        ))}
        {/* Pointer */}
        <g transform={`rotate(${angle}, 50, 50)`}>
          <line x1="50" y1="50" x2="50" y2="22" stroke="#7A1F2B" strokeWidth="3" strokeLinecap="round" />
          <circle cx="50" cy="22" r="3.5" fill="#FFB347" stroke="#7A1F2B" strokeWidth="1" />
        </g>
        {/* Centre cap */}
        <circle cx="50" cy="50" r="6" fill="#1A1612" />
        <circle cx="50" cy="50" r="6" fill="url(#knobInset)" />
      </svg>
    </div>
  );
};

// ════════════════════════════════════════════════════════════════════
// MAIN COMPONENT
// ════════════════════════════════════════════════════════════════════
const BPMDelayCalculator = () => {
  // Inject fonts + styles
  useEffect(() => {
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = FONT_LINK_HREF;
    document.head.appendChild(link);

    const style = document.createElement('style');
    style.textContent = TAPE_LAB_CSS;
    document.head.appendChild(style);

    return () => { link.remove(); style.remove(); };
  }, []);

  // ─── State ───
  const [mode, setMode] = useState('studio'); // 'studio' | 'sync'
  const [bpm, setBpm] = useState(120);
  const [selectedNoteId, setSelectedNoteId] = useState('quarter');
  const [feedback, setFeedback] = useState(0.42);
  const [mix, setMix] = useState(0.5);
  const [tone, setTone] = useState(0.5);   // LP filter on wet, 0=closed 1=open
  const [trim, setTrim] = useState(0.7);   // master output

  const [hotPad, setHotPad] = useState(null);
  const [activeSourceId, setActiveSourceId] = useState('kick');
  const [loopOn, setLoopOn] = useState(false);
  const [beat, setBeat] = useState(-1);
  const [echoMarkers, setEchoMarkers] = useState([]); // {at, decay, lane}

  // Sync challenge state
  const [syncQ, setSyncQ] = useState(null); // { bpm, noteId, attempts }
  const [syncAnswer, setSyncAnswer] = useState('');
  const [syncResult, setSyncResult] = useState(null);

  // Tap tempo
  const tapTimes = useRef([]);
  const [tapHint, setTapHint] = useState('TAP');

  const selectedNote = NOTE_VALUES.find(n => n.id === selectedNoteId);
  const ms = calcMs(bpm, selectedNote.multiplier);

  // ─── Audio engine refs ───
  const ctxRef = useRef(null);
  const masterRef = useRef(null);
  const dryRef = useRef(null);
  const wetRef = useRef(null);
  const delayRef = useRef(null);
  const fbRef = useRef(null);
  const filterRef = useRef(null);
  const loopTimerRef = useRef(null);
  const beatStartRef = useRef(0);
  const tapeAnimRef = useRef(null);
  const canvasRef = useRef(null);

  const ensureAudio = useCallback(() => {
    if (ctxRef.current) {
      if (ctxRef.current.state === 'suspended') ctxRef.current.resume();
      return ctxRef.current;
    }
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const master = ctx.createGain(); master.gain.value = trim; master.connect(ctx.destination);
    const dry = ctx.createGain();    dry.gain.value = 1 - mix;
    const wet = ctx.createGain();    wet.gain.value = mix;
    const delay = ctx.createDelay(4); delay.delayTime.value = ms / 1000;
    const fb = ctx.createGain();      fb.gain.value = feedback;
    const filt = ctx.createBiquadFilter();
    filt.type = 'lowpass'; filt.frequency.value = 400 + tone * 11600;
    filt.Q.value = 0.6;

    dry.connect(master);
    delay.connect(filt);
    filt.connect(fb);
    fb.connect(delay);
    filt.connect(wet);
    wet.connect(master);

    ctxRef.current = ctx;
    masterRef.current = master;
    dryRef.current = dry;
    wetRef.current = wet;
    delayRef.current = delay;
    fbRef.current = fb;
    filterRef.current = filt;
    return ctx;
  // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  // Live-update audio params when state changes
  useEffect(() => {
    if (!ctxRef.current) return;
    const t = ctxRef.current.currentTime;
    delayRef.current.delayTime.linearRampToValueAtTime(ms / 1000, t + 0.05);
  }, [ms]);
  useEffect(() => {
    if (!ctxRef.current) return;
    const t = ctxRef.current.currentTime;
    fbRef.current.gain.linearRampToValueAtTime(feedback, t + 0.05);
  }, [feedback]);
  useEffect(() => {
    if (!ctxRef.current) return;
    const t = ctxRef.current.currentTime;
    dryRef.current.gain.linearRampToValueAtTime(1 - mix, t + 0.05);
    wetRef.current.gain.linearRampToValueAtTime(mix, t + 0.05);
  }, [mix]);
  useEffect(() => {
    if (!ctxRef.current) return;
    const t = ctxRef.current.currentTime;
    filterRef.current.frequency.linearRampToValueAtTime(400 + tone * 11600, t + 0.05);
  }, [tone]);
  useEffect(() => {
    if (!ctxRef.current) return;
    const t = ctxRef.current.currentTime;
    masterRef.current.gain.linearRampToValueAtTime(trim, t + 0.05);
  }, [trim]);

  // ─── Trigger source ───
  const triggerSource = useCallback((sourceId) => {
    const ctx = ensureAudio();
    const src = SOURCES.find(s => s.id === sourceId) || SOURCES[0];
    const splitter = ctx.createGain();
    splitter.gain.value = 1;
    splitter.connect(dryRef.current);
    splitter.connect(delayRef.current);
    src.synth(ctx, ctx.currentTime + 0.005, splitter);
    setHotPad(sourceId);
    setTimeout(() => setHotPad(null), 110);

    // Echo markers for the tape grid
    const beatMs = 60000 / bpm;
    const totalMs = beatMs * 4; // visible window = 1 bar
    const markers = [];
    let echoTime = 0;
    let lvl = 1;
    const startedAt = (performance.now() - beatStartRef.current);
    while (lvl > 0.05 && markers.length < 20) {
      echoTime += ms;
      const at = startedAt + echoTime;
      lvl *= feedback || 0.001;
      markers.push({ at, level: lvl, lane: 'echo', born: performance.now() });
      if (!feedback) break;
    }
    markers.unshift({ at: startedAt, level: 1, lane: 'source', born: performance.now() });
    setEchoMarkers(prev => [...prev.filter(m => performance.now() - m.born < 4000), ...markers]);
  }, [bpm, ms, feedback, ensureAudio]);

  // ─── Backing loop (Sync Challenge) ───
  useEffect(() => {
    if (!loopOn) {
      if (loopTimerRef.current) { clearInterval(loopTimerRef.current); loopTimerRef.current = null; }
      setBeat(-1);
      return;
    }
    const ctx = ensureAudio();
    const targetBpm = mode === 'sync' && syncQ ? syncQ.bpm : bpm;
    const beatSec = 60 / targetBpm;
    let nextTime = ctx.currentTime + 0.1;
    let b = 0;
    beatStartRef.current = performance.now() + 100;
    const lookahead = () => {
      const ahead = ctx.currentTime + 0.18;
      while (nextTime < ahead) {
        const onWhich = b % 4;
        // Drum pattern: kick on 1 & 3, snare on 2 & 4, hat on every 8th
        if (onWhich === 0 || onWhich === 2) synths.kick(ctx, nextTime, masterRef.current);
        if (onWhich === 1 || onWhich === 3) synths.snare(ctx, nextTime, masterRef.current);
        synths.rim(ctx, nextTime + beatSec/2, masterRef.current);
        const visualAt = (nextTime - ctx.currentTime) * 1000;
        const beatNow = b;
        setTimeout(() => setBeat(beatNow % 4), Math.max(0, visualAt));
        b++;
        nextTime += beatSec;
      }
    };
    lookahead();
    loopTimerRef.current = setInterval(lookahead, 25);
    return () => {
      if (loopTimerRef.current) { clearInterval(loopTimerRef.current); loopTimerRef.current = null; }
      setBeat(-1);
    };
  }, [loopOn, bpm, mode, syncQ, ensureAudio]);

  // ─── Tape canvas (the rolling visualisation) ───
  const drawTape = useCallback(() => {
    const c = canvasRef.current;
    if (!c) return;
    const ctx2d = c.getContext('2d');
    const W = c.clientWidth; const H = 132;
    const dpr = window.devicePixelRatio || 1;
    if (c.width !== W * dpr || c.height !== H * dpr) {
      c.width = W * dpr; c.height = H * dpr; c.style.height = H + 'px';
      ctx2d.scale(dpr, dpr);
    }
    // Tape body
    ctx2d.fillStyle = '#2F1F12'; ctx2d.fillRect(0, 0, W, H);
    // Tape stripes (texture)
    ctx2d.strokeStyle = 'rgba(255,179,71,0.04)';
    ctx2d.lineWidth = 1;
    for (let i = 0; i < H; i += 3) {
      ctx2d.beginPath(); ctx2d.moveTo(0, i); ctx2d.lineTo(W, i); ctx2d.stroke();
    }
    // Lane labels
    ctx2d.fillStyle = 'rgba(255,179,71,0.4)';
    ctx2d.font = "10px 'JetBrains Mono', monospace";
    ctx2d.textAlign = 'left';
    ctx2d.fillText('SOURCE', 12, 22);
    ctx2d.fillText('ECHOES', 12, 78);

    // Beat ticks (1 bar visible = 4 beats)
    const beatMs = 60000 / bpm;
    const totalMs = beatMs * 4;
    ctx2d.strokeStyle = 'rgba(255,179,71,0.18)';
    ctx2d.lineWidth = 1;
    for (let i = 0; i <= 16; i++) {
      const x = (i / 16) * W;
      const isBeat = i % 4 === 0;
      ctx2d.strokeStyle = isBeat ? 'rgba(255,179,71,0.5)' : 'rgba(255,179,71,0.12)';
      ctx2d.beginPath(); ctx2d.moveTo(x, 32); ctx2d.lineTo(x, H - 22); ctx2d.stroke();
      if (isBeat) {
        ctx2d.fillStyle = 'rgba(255,179,71,0.6)';
        ctx2d.font = "9px 'JetBrains Mono', monospace";
        ctx2d.textAlign = 'center';
        ctx2d.fillText(String(i / 4 + 1), x, H - 8);
      }
    }

    // Playhead (when loop on)
    if (loopOn) {
      const elapsed = (performance.now() - beatStartRef.current) % totalMs;
      const px = (elapsed / totalMs) * W;
      ctx2d.strokeStyle = '#7FBF3F';
      ctx2d.lineWidth = 2;
      ctx2d.shadowColor = 'rgba(127, 191, 63, 0.7)';
      ctx2d.shadowBlur = 8;
      ctx2d.beginPath(); ctx2d.moveTo(px, 30); ctx2d.lineTo(px, H - 22); ctx2d.stroke();
      ctx2d.shadowBlur = 0;
    }

    // Echo markers
    const now = performance.now();
    echoMarkers.forEach(m => {
      const lifeMs = now - m.born;
      if (lifeMs > 4000) return;
      const pos = (m.at % totalMs) / totalMs;
      const x = pos * W;
      const isSource = m.lane === 'source';
      const y = isSource ? 44 : 96;
      const baseAlpha = Math.max(0, 1 - lifeMs / 3500);
      const r = isSource ? 9 : 6;
      ctx2d.fillStyle = isSource
        ? `rgba(255, 179, 71, ${baseAlpha})`
        : `rgba(197, 48, 48, ${baseAlpha * (m.level || 1)})`;
      ctx2d.shadowColor = isSource ? 'rgba(255,179,71,0.7)' : 'rgba(197,48,48,0.6)';
      ctx2d.shadowBlur = isSource ? 16 : 10;
      ctx2d.beginPath(); ctx2d.arc(x, y, r, 0, Math.PI * 2); ctx2d.fill();
      ctx2d.shadowBlur = 0;
    });

    tapeAnimRef.current = requestAnimationFrame(drawTape);
  }, [bpm, loopOn, echoMarkers]);

  useEffect(() => {
    drawTape();
    return () => { if (tapeAnimRef.current) cancelAnimationFrame(tapeAnimRef.current); };
  }, [drawTape]);

  // ─── Tap tempo ───
  const handleTap = () => {
    const now = performance.now();
    const arr = tapTimes.current;
    if (arr.length && now - arr[arr.length - 1] > 2200) {
      tapTimes.current = [now]; setTapHint('AGAIN'); return;
    }
    arr.push(now);
    if (arr.length > 8) arr.shift();
    if (arr.length >= 2) {
      const intervals = [];
      for (let i = 1; i < arr.length; i++) intervals.push(arr[i] - arr[i - 1]);
      const avg = intervals.reduce((a, b) => a + b, 0) / intervals.length;
      const newBpm = Math.round(60000 / avg);
      if (newBpm >= 40 && newBpm <= 220) { setBpm(newBpm); setTapHint(`${newBpm}`); }
      else setTapHint('RANGE');
    } else setTapHint('AGAIN');
  };

  // ─── Keyboard shortcuts ───
  useEffect(() => {
    const onKey = (e) => {
      if (e.target.tagName === 'INPUT') return;
      const num = parseInt(e.key, 10);
      if (!Number.isNaN(num) && num >= 1 && num <= 6) {
        const src = SOURCES[num - 1];
        if (src) { setActiveSourceId(src.id); triggerSource(src.id); e.preventDefault(); }
      } else if (e.code === 'Space') {
        triggerSource(activeSourceId); e.preventDefault();
      } else if (e.key === 't' || e.key === 'T') {
        handleTap();
      } else if (e.key === 'p' || e.key === 'P') {
        setLoopOn(v => !v);
      }
    };
    window.addEventListener('keydown', onKey);
    return () => window.removeEventListener('keydown', onKey);
  // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [activeSourceId, triggerSource]);

  // ─── Drawer state ───
  const [drawer, setDrawer] = useState(null); // 'theory' | 'reference' | null
  useEffect(() => {
    const onEsc = (e) => { if (e.key === 'Escape') setDrawer(null); };
    window.addEventListener('keydown', onEsc);
    return () => window.removeEventListener('keydown', onEsc);
  }, []);

  // ─── Sync Challenge ───
  const newSyncChallenge = () => {
    const bpms = [80, 90, 100, 110, 120, 128, 132, 140, 150];
    const targetBpm = bpms[Math.floor(Math.random() * bpms.length)];
    // Weight common note values higher
    const pool = [
      'quarter','quarter','quarter',
      'eighth','eighth','eighth',
      'dotted-eighth','dotted-eighth',
      'sixteenth','sixteenth',
      'half',
      'eighth-triplet',
      'dotted-quarter',
    ];
    const targetNoteId = pool[Math.floor(Math.random() * pool.length)];
    setSyncQ({ bpm: targetBpm, noteId: targetNoteId, attempts: 0 });
    setBpm(targetBpm);
    setSyncAnswer('');
    setSyncResult(null);
    setLoopOn(true);
  };

  const checkSync = () => {
    if (!syncQ) return;
    const guess = parseFloat(syncAnswer);
    const target = NOTE_VALUES.find(n => n.id === syncQ.noteId);
    const correctMs = calcMs(syncQ.bpm, target.multiplier);
    if (Number.isNaN(guess)) {
      setSyncResult({ correct: false, msg: 'Type a number — milliseconds.' });
      return;
    }
    const within = Math.abs(guess - correctMs) <= 5;
    setSyncResult({
      correct: within,
      msg: within
        ? `Locked. ${target.spoken} at ${syncQ.bpm} BPM = ${correctMs.toFixed(1)} ms.`
        : `Not in sync. The answer is ${Math.round(correctMs)} ms — that's a ${target.spoken}. You typed ${guess} ms.`,
      target,
      correctMs,
    });
    if (within) {
      // Lock the calculator to the target
      setSelectedNoteId(syncQ.noteId);
    }
  };

  // Initialise first sync challenge when entering sync mode
  useEffect(() => {
    if (mode === 'sync' && !syncQ) newSyncChallenge();
    if (mode === 'studio') { setLoopOn(false); setSyncQ(null); setSyncResult(null); }
  // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [mode]);

  // ─── Render ───
  const formulaJSX = (
    <span>
      60,000 ÷ <em>{bpm}</em> × <em>{selectedNote.multiplier === 1/3 ? '0.333' : selectedNote.multiplier}</em> =
    </span>
  );

  return (
    <div className="tape-lab">
      {/* HEADER */}
      <header className="tl-header">
        <div>
          <div className="tl-eyebrow">Topic 2.5 Numeracy · 1.12 Delay</div>
          <h1 className="tl-title">
            Tape <span className="amp">&amp;</span> Sync
            <span className="tl-stamp">REC · A-LEVEL</span>
          </h1>
        </div>
        <div className="tl-tag-row">
          <span className="tl-tag crimson">CALCULATOR</span>
          <span className={`tl-tag ${loopOn ? 'live' : ''}`}>{loopOn ? '● LIVE' : 'STANDBY'}</span>
        </div>
      </header>

      {/* MAIN */}
      <main className="tl-main">

        {/* LEFT RAIL */}
        <aside className="tl-rail">
          {/* Mode */}
          <div className="tl-rail-section" style={{ padding: 0, border: 'none' }}>
            <div className="tl-modes">
              <button
                className={`tl-mode ${mode === 'studio' ? 'active' : ''}`}
                onClick={() => setMode('studio')}
              >Studio</button>
              <button
                className={`tl-mode ${mode === 'sync' ? 'active' : ''}`}
                onClick={() => setMode('sync')}
              >Sync ▸</button>
            </div>
          </div>

          {/* Source pads */}
          <div className="tl-rail-section">
            <div className="tl-rail-label">
              <span>Source</span>
              <span style={{ color: 'var(--ink-faded)', textTransform: 'none', letterSpacing: 'normal', fontSize: 9 }}>tap or 1–6</span>
            </div>
            <div className="tl-pads">
              {SOURCES.map(s => (
                <div
                  key={s.id}
                  className={`tl-pad ${hotPad === s.id ? 'hot' : ''}`}
                  onClick={() => { setActiveSourceId(s.id); triggerSource(s.id); }}
                  role="button" tabIndex={0}
                >
                  <div className="tl-pad-key">{s.key}</div>
                  <div className="tl-pad-name">{s.label}</div>
                </div>
              ))}
            </div>
            <div style={{ marginTop: 12, fontFamily: 'var(--f-mono)', fontSize: 10, color: 'var(--ink-faded)', letterSpacing: '0.12em' }}>
              SPACE · re-trigger {SOURCES.find(s=>s.id===activeSourceId)?.label}
            </div>
          </div>

          {/* Loop toggle */}
          <div className="tl-rail-section">
            <div className="tl-rail-label"><span>Backing</span><span>P</span></div>
            <button
              className={`tl-button ${loopOn ? 'crimson' : ''}`}
              onClick={() => setLoopOn(v => !v)}
              style={{ width: '100%' }}
            >
              {loopOn ? '■ Stop loop' : '▸ Drum loop'}
            </button>
            <div style={{ marginTop: 10, fontFamily: 'var(--f-body)', fontSize: 12, color: 'var(--ink-faded)', lineHeight: 1.4 }}>
              {mode === 'sync' && syncQ
                ? `Loop locked to ${syncQ.bpm} BPM — your delay should fit the groove.`
                : 'A 4-on-the-floor pattern at the chosen BPM. Use it to hear your delay land in time.'}
            </div>
          </div>
        </aside>

        {/* ENGINE */}
        <section className="tl-engine">
          <div className="tl-engine-header">
            <div>
              <div className="tape-stencil" style={{ color: 'var(--ink-faded)' }}>Delay engine · model TL-1</div>
              <div style={{ fontFamily: 'var(--f-display)', fontSize: 24, fontWeight: 800, fontStyle: 'italic', color: 'var(--oxblood)', lineHeight: 1, marginTop: 4 }}>
                {selectedNote.spoken}
              </div>
            </div>
            <div className="tl-leds">
              {[0,1,2,3].map(i => (
                <div key={i} className={`tl-led ${beat === i ? 'on beat' : ''}`} />
              ))}
              <div className={`tl-led ${syncResult?.correct ? 'on lock' : ''}`} title="Sync lock" />
            </div>
          </div>

          {/* THE READOUT */}
          <div className="tl-readout">
            <div className="tl-readout-formula">{formulaJSX}</div>
            <div className="tl-readout-value">
              {ms.toFixed(1)}<span className="tl-readout-unit">MS</span>
            </div>
            <div className="tl-readout-meta">
              <span>BPM {bpm}</span>
              <span>× {selectedNote.multiplier === 1/3 ? '0.333…' : selectedNote.multiplier}</span>
              <span>≈ {Math.round(ms)} MS</span>
            </div>
          </div>

          {/* BPM */}
          <div className="tl-bpm-row" style={{ marginBottom: 18 }}>
            <div className="tl-bpm-display">
              {bpm}<span className="small">BPM</span>
            </div>
            <input
              className="tl-bpm-slider" type="range" min="40" max="220"
              value={bpm} onChange={e => setBpm(parseInt(e.target.value, 10))}
            />
            <button className="tl-button tap" onClick={handleTap}>{tapHint}</button>
            <div className="tl-bpm-presets">
              {[80, 100, 120, 128, 140].map(p => (
                <button key={p} className={`tl-bpm-preset ${bpm === p ? 'active' : ''}`} onClick={() => setBpm(p)}>{p}</button>
              ))}
            </div>
          </div>

          {/* NOTE PICKER */}
          <div>
            <div className="tape-stencil" style={{ color: 'var(--ink-faded)' }}>Note value</div>
            <div className="tl-notes">
              {NOTE_VALUES.map(n => (
                <div
                  key={n.id}
                  className={`tl-note-btn ${selectedNoteId === n.id ? 'active' : ''}`}
                  onClick={() => setSelectedNoteId(n.id)}
                  role="button" tabIndex={0}
                >
                  <div className="tl-note-symbol">{n.symbol}</div>
                  <div className="tl-note-label">{n.label}</div>
                  <div className="tl-note-ms">{Math.round(calcMs(bpm, n.multiplier))}ms</div>
                </div>
              ))}
            </div>
          </div>

          {/* KNOBS */}
          <div className="tl-knobs">
            <div className="tl-knob-cell">
              <Knob value={feedback} min={0} max={0.92} step={0.01} onChange={setFeedback} ariaLabel="Feedback" />
              <div className="tl-knob-label">Feedback</div>
              <div className="tl-knob-value">{Math.round(feedback * 100)}%</div>
            </div>
            <div className="tl-knob-cell">
              <Knob value={mix} min={0} max={1} step={0.01} onChange={setMix} ariaLabel="Wet / Dry mix" />
              <div className="tl-knob-label">Mix</div>
              <div className="tl-knob-value">{Math.round(mix * 100)}% wet</div>
            </div>
            <div className="tl-knob-cell">
              <Knob value={tone} min={0} max={1} step={0.01} onChange={setTone} ariaLabel="Tone (low-pass on wet)" />
              <div className="tl-knob-label">Tone</div>
              <div className="tl-knob-value">{Math.round(400 + tone * 11600)}Hz</div>
            </div>
            <div className="tl-knob-cell">
              <Knob value={trim} min={0} max={1} step={0.01} onChange={setTrim} ariaLabel="Output level" />
              <div className="tl-knob-label">Trim</div>
              <div className="tl-knob-value">{Math.round(trim * 100)}%</div>
            </div>
          </div>

          {/* TRANSPORT */}
          <div className="tl-transport">
            <button className="tl-button primary" onClick={() => triggerSource(activeSourceId)}>
              ▸ Trigger
            </button>
            <button className="tl-button ghost" onClick={() => { setEchoMarkers([]); setBpm(120); setSelectedNoteId('quarter'); setFeedback(0.42); setMix(0.5); setTone(0.5); }}>
              ↺ Reset
            </button>
            <div style={{ flex: 1 }} />
            <button className="tl-button ghost" onClick={() => setDrawer('theory')}>ⓘ Theory</button>
            <button className="tl-button ghost" onClick={() => setDrawer('reference')}>≡ Reference</button>
          </div>

          {/* TAPE GRID */}
          <div className="tl-tape">
            <canvas ref={canvasRef} style={{ width: '100%' }} />
          </div>

          {/* SYNC CHALLENGE */}
          {mode === 'sync' && syncQ && (
            <div className="tl-challenge">
              <div className="tl-challenge-q">
                Backing track: <strong>{syncQ.bpm} BPM</strong>. Adjust the note value above until the echoes lock to the groove. Then type the delay time you've dialled in.
              </div>
              <div className="tl-challenge-row">
                <input
                  className="tl-input"
                  type="number" placeholder="ms"
                  value={syncAnswer}
                  onChange={e => setSyncAnswer(e.target.value)}
                  onKeyDown={e => { if (e.key === 'Enter' && !syncResult) checkSync(); }}
                  disabled={!!syncResult}
                />
                {!syncResult ? (
                  <button className="tl-button primary" onClick={checkSync}>Check</button>
                ) : (
                  <button className="tl-button primary" onClick={newSyncChallenge}>Next →</button>
                )}
                <div style={{ flex: 1 }} />
                <button className="tl-button ghost" onClick={newSyncChallenge}>↻ Skip</button>
              </div>
              {syncResult && (
                <div className={`tl-feedback ${syncResult.correct ? 'correct' : 'wrong'}`}>
                  <strong style={{ display: 'block', marginBottom: 4 }}>{syncResult.correct ? '✓ Locked' : '✗ Off the grid'}</strong>
                  {syncResult.msg}
                  {!syncResult.correct && (
                    <div style={{ marginTop: 8, fontSize: 13, color: 'var(--ink-faded)', fontFamily: 'var(--f-mono)' }}>
                      working: 60,000 ÷ {syncQ.bpm} × {syncResult.target.multiplier === 1/3 ? '0.333' : syncResult.target.multiplier} = {syncResult.correctMs.toFixed(1)} ms
                    </div>
                  )}
                </div>
              )}
            </div>
          )}
        </section>
      </main>

      {/* DRAWER HANDLES (always visible at right edge) */}
      <div className="tl-drawer-handle">
        <button onClick={() => setDrawer('theory')}>Theory</button>
        <button onClick={() => setDrawer('reference')}>Reference</button>
      </div>

      {/* DRAWER */}
      {drawer && (
        <>
          <div className="tl-drawer-overlay" onClick={() => setDrawer(null)} />
          <div className="tl-drawer">
            <button className="tl-drawer-close" onClick={() => setDrawer(null)}>×</button>
            {drawer === 'theory' && <TheoryPanel />}
            {drawer === 'reference' && <ReferencePanel onPickBpm={(b) => { setBpm(b); setDrawer(null); }} />}
          </div>
        </>
      )}
    </div>
  );
};

// ════════════════════════════════════════════════════════════════════
// THEORY PANEL
// ════════════════════════════════════════════════════════════════════
const TheoryPanel = () => (
  <>
    <h2>The maths</h2>
    <p>BPM is <em>beats per minute</em>. One minute is 60,000 milliseconds. Divide and you get the duration of one beat — one quarter note in 4/4 time.</p>
    <div className="formula-block">DELAY (ms) = 60,000 ÷ BPM × NOTE</div>
    <p>Multiply by a note value to scale up or down. Quarter = 1, eighth = 0.5 (twice as fast), half = 2 (twice as slow). Dotted notes multiply by 1.5; triplets multiply by 2/3 (or divide the parent note by 3).</p>

    <h3>Worked example</h3>
    <p>120 BPM, dotted eighth.</p>
    <ol>
      <li><strong>Quarter:</strong> 60,000 ÷ 120 = <span style={{ fontFamily: 'var(--f-mono)' }}>500 ms</span></li>
      <li><strong>Eighth:</strong> 500 ÷ 2 = <span style={{ fontFamily: 'var(--f-mono)' }}>250 ms</span></li>
      <li><strong>Dotted eighth:</strong> 250 × 1.5 = <span style={{ fontFamily: 'var(--f-mono)' }}>375 ms</span></li>
    </ol>
    <p style={{ fontStyle: 'italic', color: 'var(--ink-faded)' }}>375 ms is the iconic U2/The Edge guitar delay. Each echo lands a sixteenth before the next eighth — weaving across the beat.</p>

    <h3>Dotted vs triplet</h3>
    <p>Dotted = ×1.5 (longer). Triplet = ×2/3 (shorter). Dotted notes feel <em>longer</em> than the source; triplets feel <em>shorter</em>. Mark schemes routinely catch students who multiply triplets by 1.5 or dotted notes by 0.667.</p>

    <h3>Why bother?</h3>
    <p>Modern plugins offer tempo-sync — click a button, pick a note value. But the exam expects you to derive it on paper. Vintage hardware (Echoplex, Space Echo) only has a delay-time-in-ms dial — engineers calculate by hand or by ear. Both routes through the same formula.</p>

    <h3>Watch out for</h3>
    <ul>
      <li>Forgetting milliseconds (writing 0.5 for a quarter at 120 BPM).</li>
      <li>Rounding too early — keep one decimal through the working, only round at the end.</li>
      <li>Triplet maths: an eighth triplet = quarter ÷ 3, not eighth ÷ 3. Three triplet eighths fit in <em>one</em> beat.</li>
      <li>BPM always refers to the quarter note in 4/4. Always derive the quarter first, then scale.</li>
    </ul>
  </>
);

// ════════════════════════════════════════════════════════════════════
// REFERENCE PANEL
// ════════════════════════════════════════════════════════════════════
const REF_BPMS = [
  { bpm: 90,  genre: 'Hip-hop / R&B' },
  { bpm: 100, genre: 'Reggae / Rock ballad' },
  { bpm: 110, genre: 'Mid-tempo pop' },
  { bpm: 120, genre: 'Pop / dance pop' },
  { bpm: 128, genre: 'House / EDM' },
  { bpm: 140, genre: 'Drum & bass' },
];

const ReferencePanel = ({ onPickBpm }) => (
  <>
    <h2>Reference</h2>
    <p>All values rounded to whole milliseconds. Click any BPM to load it into the calculator.</p>
    <table className="tl-ref-table">
      <thead>
        <tr>
          <th>BPM</th>
          {NOTE_VALUES.map(n => (
            <th key={n.id} title={n.spoken}>{n.symbol}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {REF_BPMS.map(p => (
          <tr key={p.bpm} onClick={() => onPickBpm(p.bpm)}>
            <td>
              <div style={{ fontFamily: 'var(--f-mono)', fontWeight: 700, color: 'var(--oxblood)' }}>{p.bpm}</div>
              <div style={{ fontSize: 10, color: 'var(--ink-faded)', letterSpacing: '0.05em' }}>{p.genre}</div>
            </td>
            {NOTE_VALUES.map(n => (
              <td key={n.id}>{Math.round(calcMs(p.bpm, n.multiplier))}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
    <h3>Note value key</h3>
    <ul style={{ fontFamily: 'var(--f-mono)', fontSize: 12, lineHeight: 1.9 }}>
      {NOTE_VALUES.map(n => (
        <li key={n.id}><span style={{ fontFamily: 'var(--f-display)', fontSize: 18, marginRight: 8 }}>{n.symbol}</span>{n.spoken} (× {n.multiplier === 1/3 ? '0.333' : n.multiplier})</li>
      ))}
    </ul>
    <h3>Keyboard</h3>
    <ul style={{ fontFamily: 'var(--f-mono)', fontSize: 12, lineHeight: 1.8 }}>
      <li><strong>1–6</strong> · trigger source pad</li>
      <li><strong>Space</strong> · re-trigger active pad</li>
      <li><strong>T</strong> · tap tempo</li>
      <li><strong>P</strong> · play/stop drum loop</li>
      <li><strong>Esc</strong> · close drawer</li>
    </ul>
  </>
);

export default BPMDelayCalculator;
